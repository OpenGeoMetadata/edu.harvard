{"gbl_mdVersion_s":"Aardvark","id":"harvard-mgisc5000a","dct_title_s":"MassGIS 2003 Massachusetts Elevation Contours (1:5,000) (September 2002)","gbl_wxsIdentifier_s":"vector_public:MGISC5000A","dct_accessRights_s":"Public","dcat_bbox":"ENVELOPE(-73.20185, -69.898956, 42.908627, 41.464662)","dct_creator_sm":["MassGIS (Office : Mass.)"],"dct_issued_s":"2003-05-19","dct_description_sm":["The Elevation Contours (1:5,000) datalayer represents 3-meter contours created from Digital Terrain Model (DTM) data points collected during the production of the 1:5,000 Black and White Digital Orthophoto images. This datalayer had previously been a mix of data from the DTMs as well as some 1:25,000 Digital Line Graph (DLG) data obtained from the U.S. Geological Society. As of August, 2001, all older USGS data have been replaced by the 1:5,000 product."],"dct_format_s":"Shapefile","locn_geometry":"ENVELOPE(-73.20185, -69.898956, 42.908627, 41.464662)","gbl_indexYear_im":[2002],"gbl_mdModified_dt":"2006-06-19T00:00:00Z","schema_provider_s":"Harvard","dct_publisher_sm":["Office of Geographic and Environmental Information (MassGIS)"],"dct_spatial_sm":["Massachusetts"],"dct_subject_sm":["Altitudes","Contours (Cartography)","Altitudes -- Measurement","elevation"],"dct_temporal_sm":["2002"],"harvard_localCollectionLabel_sm":["MassGIS data"],"harvard_collectionID_sm":["990077651710203941"],"dct_identifier_sm":["https://hgl.harvard.edu/catalog/harvard-mgisc5000a","MGISC5000A","https://id.lib.harvard.edu/alma/990077651710203941/catalog"],"gbl_resourceClass_sm":["Datasets"],"dct_references_s":"{\"http://www.opengis.net/cat/csw/csdgm\":\"https://raw.githubusercontent.com/harvard-library/harvard-geodata/main/fgdc/MGISC5000A.xml\",\"http://www.opengis.net/def/serviceType/ogc/wms\":\"https://geodata.lib.harvard.edu/vector_public/wms\",\"http://schema.org/downloadUrl\":\"https://mps.lib.harvard.edu/assets/file/hgl:MGISC5000A\"}"}