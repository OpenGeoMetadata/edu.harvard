{"gbl_mdVersion_s":"Aardvark","id":"harvard-cambridge09-addresspoints","dct_title_s":"Building Address Points, Cambridge, Massachusetts, December 2007","gbl_wxsIdentifier_s":"vector_restricted:CAMBRIDGE09_ADDRESSPOINTS","dct_accessRights_s":"Restricted","dcat_bbox":"ENVELOPE(-71.160131, -71.068504, 42.403536, 42.353105)","dct_creator_sm":["Cambridge (Mass.). Geographic Information Systems"],"dct_issued_s":"2007","dct_description_sm":["This point layer contains all building centroid points within the City of Cambridge and addresses associated with each building from the Master Address database. For buildings with more than one address, address points are stacked on top of one another at the centroid point. Buildings with no associated address (such as garages, sheds, and warehouses) have address points at their centroid but contain null addresses."],"dct_format_s":"Shapefile","locn_geometry":"ENVELOPE(-71.160131, -71.068504, 42.403536, 42.353105)","gbl_indexYear_im":[2007],"gbl_mdModified_dt":"2010-03-23T00:00:00Z","schema_provider_s":"Harvard","dct_publisher_sm":["City of Cambridge, GIS Dept."],"dct_spatial_sm":["Massachusetts","Cambridge"],"dct_subject_sm":["Municipal","Street addresses","location","Address points, building addresses"],"dct_temporal_sm":["2007"],"harvard_collectionID_sm":["990125155600203941"],"dct_identifier_sm":["https://hgl.harvard.edu/catalog/harvard-cambridge09-addresspoints","CAMBRIDGE09_ADDRESSPOINTS","https://id.lib.harvard.edu/alma/990125155600203941/catalog"],"gbl_resourceClass_sm":["Datasets"],"dct_references_s":"{\"http://www.opengis.net/cat/csw/csdgm\":\"https://raw.githubusercontent.com/harvard-library/harvard-geodata/main/fgdc/CAMBRIDGE09_ADDRESSPOINTS.xml\",\"http://www.opengis.net/def/serviceType/ogc/wms\":\"https://geodata.lib.harvard.edu/vector_restricted/wms\",\"http://schema.org/downloadUrl\":\"https://mps.lib.harvard.edu/assets/file/hgl:CAMBRIDGE09_ADDRESSPOINTS\"}"}