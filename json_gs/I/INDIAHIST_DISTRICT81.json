{"gbl_mdVersion_s":"Aardvark","id":"harvard-indiahist-district81","dct_title_s":"India : District Boundaries, 1981","gbl_wxsIdentifier_s":"vector_restricted:INDIAHIST_DISTRICT81","dct_accessRights_s":"Restricted","dcat_bbox":"ENVELOPE(68.196831, 97.409096, 37.121712, 6.767454)","dct_creator_sm":["ML InfoMap (Firm)"],"dct_issued_s":"2008","dct_description_sm":["This datalayer shows district boundaries of India for 1981. Includes district socio-demographic Census attribute data such as total population, population by sex, rural/urban populations, household and employment statistics. This layer is part of the India HistoricMap dataset showing decadal change in district boundaries of India since 1951. Socio-demographic data is included for the Census years i.e. 1951, 1961, 1971, 1981, 1991 and 2001. This data layer is sourced from secondary government sources, chiefly Survey of India, Census of India, Election Commission, etc. Scale 1:1,000,000."],"dct_format_s":"Shapefile","locn_geometry":"ENVELOPE(68.196831, 97.409096, 37.121712, 6.767454)","gbl_indexYear_im":[1981],"gbl_mdModified_dt":"2008-06-09T00:00:00Z","schema_provider_s":"Harvard","dct_publisher_sm":["ML InfoMap Pvt. Ltd."],"dct_spatial_sm":["India"],"dct_subject_sm":["Administrative and political divisions","Boundaries","Census","Demography","Population Statistics","Sex Statistics","Housing Statistics","Labor supply","Literacy","Caste","boundaries","society","economy"],"dct_temporal_sm":["1981"],"harvard_collectionID_sm":["990114517480203941"],"dct_identifier_sm":["https://hgl.harvard.edu/catalog/harvard-indiahist-district81","INDIAHIST_DISTRICT81","https://id.lib.harvard.edu/alma/990114517480203941/catalog"],"gbl_resourceClass_sm":["Datasets"],"dct_references_s":"{\"http://www.opengis.net/cat/csw/csdgm\":\"https://raw.githubusercontent.com/harvard-library/harvard-geodata/main/fgdc/INDIAHIST_DISTRICT81.xml\",\"http://www.opengis.net/def/serviceType/ogc/wms\":\"https://geodata.lib.harvard.edu/vector_restricted/