{"gbl_mdVersion_s":"Aardvark","id":"harvard-indiamap-town","dct_title_s":"India : Towns with Census Data, 2001","gbl_wxsIdentifier_s":"vector_restricted:INDIAMAP_TOWN","dct_accessRights_s":"Restricted","dcat_bbox":"ENVELOPE(68.960663, 96.16851, 34.525982, 8.095102000000001)","dct_creator_sm":["ML InfoMap (Firm)"],"dct_issued_s":"2008","dct_description_sm":["This datalayer shows towns of India for 2001. Includes town socio-demographic Census attribute data such as total population, population by sex, rural/urban populations, household, literacy, and employment statistics. This layer is part of the IndiaMap dataset which includes socio-demographic and economic Census data for 2001 at the State, District, Sub-District, and Town levels. This data layer is sourced from secondary government sources, chiefly Survey of India, Census of India, Election Commission, etc. Scale 1:1,000,000."],"dct_format_s":"Shapefile","locn_geometry":"ENVELOPE(68.960663, 96.16851, 34.525982, 8.095102000000001)","gbl_indexYear_im":[2001],"gbl_mdModified_dt":"2008-06-16T00:00:00Z","schema_provider_s":"Harvard","dct_publisher_sm":["ML InfoMap Pvt. Ltd."],"dct_spatial_sm":["India"],"dct_subject_sm":["Cities and towns","Census","Demography","Population Statistics","Sex Statistics","Housing Statistics","Labor supply","Literacy","Caste","location","society","economy"],"dct_temporal_sm":["2001"],"harvard_collectionID_sm":["990114517480203941"],"dct_identifier_sm":["https://hgl.harvard.edu/catalog/harvard-indiamap-town","INDIAMAP_TOWN","https://id.lib.harvard.edu/alma/990114517480203941/catalog"],"gbl_resourceClass_sm":["Datasets"],"dct_references_s":"{\"http://www.opengis.net/cat/csw/csdgm\":\"https://raw.githubusercontent.com/harvard-library/harvard-geodata/main/fgdc/INDIAMAP_TOWN.xml\",\"http://www.opengis.net/def/serviceType/ogc/wms\":\"https://geodata.lib.harvard.edu/vector_restricted/wms\",\"http://schema.org/downloadUrl\":\"https://mps.lib.harvard.edu/assets/file/hgl:INDIAMAP_TOWN\"}"}