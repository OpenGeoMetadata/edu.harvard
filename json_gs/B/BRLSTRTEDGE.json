{"gbl_mdVersion_s":"Aardvark","id":"harvard-brlstrtedge","dct_title_s":"Street Edges (Town of Brookline)","gbl_wxsIdentifier_s":"vector_restricted:BRLSTRTEDGE","dct_accessRights_s":"Restricted","dcat_bbox":"ENVELOPE(-71.176078, -71.105934, 42.351712, 42.294597)","dct_creator_sm":["Brookline GIS, Information Technologies Department","Boston Edison Company (BECo.)."],"dct_issued_s":"1995","dct_description_sm":["The street edge transportation coverage is a polyline layer describing the driveable surface of streets within the Town of Brookline, Massachusetts. A related transportation feature (Back Edge of Sidewalks) is in a separate coverage. This data layer is from Boston Edison Company (BECo.). The street edge data layer was originally based on aerial photographs from 1990 and 1991 at 1' = 600' negative scale. Digital planmetric data meet National Map Accuracy Standards for 1'=100' (1:1200) mapping."],"dct_format_s":"Shapefile","locn_geometry":"ENVELOPE(-71.176078, -71.105934, 42.351712, 42.294597)","gbl_indexYear_im":[1995],"gbl_mdModified_dt":"2002-09-25T00:00:00Z","schema_provider_s":"Harvard","dct_publisher_sm":[null],"dct_spatial_sm":["Brookline","Massachusetts"],"dct_subject_sm":["transportation","Municipal","Transportation","Streets","Roads","City planning"],"dct_temporal_sm":["1995"],"harvard_collectionID_sm":["990083550800203941"],"dct_identifier_sm":["https://hgl.harvard.edu/catalog/harvard-brlstrtedge","BRLSTRTEDGE","https://id.lib.harvard.edu/alma/990083550800203941/catalog"],"gbl_resourceClass_sm":["Datasets"],"dct_references_s":"{\"http://www.opengis.net/cat/csw/csdgm\":\"https://raw.githubusercontent.com/harvard-library/harvard-geodata/main/fgdc/BRLSTRTEDGE.xml\",\"http://www.opengis.net/def/serviceType/ogc/wms\":\"https://geodata.lib.harvard.edu/vector_restricted/wms\",\"http://schema.org/downloadUrl\":\"https://mps.lib.harvard.edu/assets/file/hgl:BRLSTRTEDGE\"}"}