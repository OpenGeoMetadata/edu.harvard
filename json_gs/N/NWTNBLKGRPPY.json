{"gbl_mdVersion_s":"Aardvark","id":"harvard-nwtnblkgrppy","dct_title_s":"Census Block Groups - City of Newton","gbl_wxsIdentifier_s":"vector_restricted:NWTNBLKGRPPY","dct_accessRights_s":"Restricted","dcat_bbox":"ENVELOPE(-71.270375, -71.156794, 42.367871, 42.282602)","dct_creator_sm":["City of Newton GIS"],"dct_issued_s":null,"dct_description_sm":["A polygon coverage of the boundaries of the U.S. Census Bureau's block groups and some appended demographic information for Newton, Massachusetts. Currently the most recent information is for the 1990 census. A census Block Group is a statistical subdivision of a census Tract consisting of a cluster of census blocks having the same first digit of their identifying numbers within that tract. Example, Block Group 3 contains all blocks from 3000-3999."],"dct_format_s":"Shapefile","locn_geometry":"ENVELOPE(-71.270375, -71.156794, 42.367871, 42.282602)","gbl_indexYear_im":[1990],"gbl_mdModified_dt":"2002-10-17T00:00:00Z","schema_provider_s":"Harvard","dct_publisher_sm":[null],"dct_spatial_sm":["Newton","Massachusetts"],"dct_subject_sm":["boundaries","society","Municipal","Census","Population","Demographic surveys","Households"],"dct_temporal_sm":["1990"],"harvard_collectionID_sm":["990089083800203941"],"dct_identifier_sm":["https://hgl.harvard.edu/catalog/harvard-nwtnblkgrppy","NWTNBLKGRPPY","https://id.lib.harvard.edu/alma/990089083800203941/catalog"],"gbl_resourceClass_sm":["Datasets"],"dct_references_s":"{\"http://www.opengis.net/cat/csw/csdgm\":\"https://raw.githubusercontent.com/harvard-library/harvard-geodata/main/fgdc/NWTNBLKGRPPY.xml\",\"http://www.opengis.net/def/serviceType/ogc/wms\":\"https://geodata.lib.harvard.edu/vector_restricted/wms\",\"http://schema.org/downloadUrl\":\"https://mps.lib.harvard.edu/assets/file/hgl:NWTNBLKGRPPY\"}"}